# EVkal Environment Variables
# Copy this file to .env or .env.local to connect to your live Supabase project

# Supabase Project URL (from your Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Public API Key (from your Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here
